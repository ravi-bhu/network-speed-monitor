#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "nsm_version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NSM_VERSION_MAJOR, NSM_VERSION_MINOR, NSM_VERSION_PATCH, 0
PRODUCTVERSION NSM_VERSION_MAJOR, NSM_VERSION_MINOR, NSM_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Ravi Bhushan"
            VALUE "FileDescription", "Network Speed Monitor"
            VALUE "FileVersion", NSM_VERSION_STR
            VALUE "InternalName", "NetworkSpeedMonitor"
            VALUE "LegalCopyright", "Copyright (c) 2026 Ravi Bhushan"
            VALUE "OriginalFilename", "NetworkSpeedMonitor.exe"
            VALUE "ProductName", "Network Speed Monitor"
            VALUE "ProductVersion", NSM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

// Report window dialogs. Their text is set from strings.rc when they open.
IDD_RENAME DIALOGEX 0, 0, 280, 74
STYLE DS_MODALFRAME | DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "", IDC_RENAME_PROMPT, 7, 7, 266, 18
    EDITTEXT IDC_RENAME_EDIT, 7, 28, 266, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "", IDOK, 169, 53, 50, 14, WS_TABSTOP
    PUSHBUTTON "", IDCANCEL, 223, 53, 50, 14, WS_TABSTOP
END

IDD_RANGE DIALOGEX 0, 0, 200, 80
STYLE DS_MODALFRAME | DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "", IDC_RANGE_FROM_LABEL, 7, 10, 40, 10
    CONTROL "", IDC_RANGE_FROM, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 50, 7, 143, 14
    LTEXT "", IDC_RANGE_TO_LABEL, 7, 30, 40, 10
    CONTROL "", IDC_RANGE_TO, "SysDateTimePick32", DTS_SHORTDATEFORMAT | WS_TABSTOP, 50, 27, 143, 14
    DEFPUSHBUTTON "", IDOK, 89, 59, 50, 14, WS_TABSTOP
    PUSHBUTTON "", IDCANCEL, 143, 59, 50, 14, WS_TABSTOP
END

IDD_SETTINGS DIALOGEX 0, 0, 250, 214
STYLE DS_MODALFRAME | DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    AUTOCHECKBOX "", IDC_SET_AUTOSTART, 7, 7, 236, 10, WS_TABSTOP
    LTEXT "", IDC_SET_ADAPTER_LABEL, 7, 26, 50, 10
    COMBOBOX IDC_SET_ADAPTER, 60, 24, 183, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_SET_UNITS_LABEL, 7, 46, 50, 10
    AUTORADIOBUTTON "", IDC_SET_BYTES, 60, 45, 90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_SET_BITS, 150, 45, 90, 10
    AUTOCHECKBOX "", IDC_SET_GRAPH, 7, 64, 236, 10, WS_TABSTOP
    AUTOCHECKBOX "", IDC_SET_LETTERS, 7, 79, 236, 10, WS_TABSTOP
    LTEXT "", IDC_SET_SHOW_ON_LABEL, 7, 98, 50, 10
    AUTORADIOBUTTON "", IDC_SET_PRIMARY, 60, 97, 183, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_SET_ALL, 60, 111, 183, 10
    PUSHBUTTON "", IDC_SET_MANAGE, 7, 132, 112, 14, WS_TABSTOP
    PUSHBUTTON "", IDC_SET_OPEN_FOLDER, 125, 132, 118, 14, WS_TABSTOP
    CONTROL "", IDC_SET_SEPARATOR, "Static", SS_ETCHEDHORZ, 7, 156, 236, 1
    LTEXT "", IDC_SET_ABOUT, 7, 164, 236, 10
    CONTROL "", IDC_SET_LINK, "SysLink", WS_TABSTOP, 7, 177, 236, 10
    DEFPUSHBUTTON "", IDOK, 139, 193, 50, 14, WS_TABSTOP
    PUSHBUTTON "", IDCANCEL, 193, 193, 50, 14, WS_TABSTOP
END

#include "strings.rc"
